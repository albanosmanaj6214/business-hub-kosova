generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  KOSOVO_BUSINESS
  STARTUP
  DIASPORA
  INDIVIDUAL
  ADMIN
  SUPER_ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INACTIVE
}

enum SubscriptionTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum NotificationType {
  GRANT
  FAIR
  GUIDE
  SYSTEM
  NEWS
  SUBVENTION
  OFFER_REQUEST
  MATCH
  PROFILE
}

enum VisibilityLevel {
  PRIVATE
  MEMBERS
  PUBLIC
  VERIFIED
  FEATURED
}

enum ProfileStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum StartupStage {
  IDEA
  IN_REGISTRATION
  REGISTERED_NO_REVENUE
  EARLY_REVENUE
  GROWING
}

enum LegalForm {
  BIZNES_INDIVIDUAL
  SHPK
  SHA
  ORTAKERI_E_PERGJITHSHME
  ORTAKERI_E_KUFIZUAR
  DEGE_E_HUAJ
}

enum DiasporaSubRole {
  BUYER
  INVESTOR
  DISTRIBUTOR
  IMPORTER
  PARTNER
  SERVICE_PROVIDER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELED
  COMPLETED
}

enum EventType {
  FAIR
  TRAINING
  WEBINAR
  MATCHMAKING
  WORKSHOP
  CONFERENCE
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  // Çaktivizim nga admini. false => login bllokohet DHE sesioni ekzistues bie
  // brenda 5 min (shih jwt callback te auth.ts).
  isActive        Boolean   @default(true)
  // Hyrja e fundit. Auditimi i plotë i hyrjeve rri te AuditLog (LOGIN / LOGIN_FAILED).
  lastLoginAt     DateTime?
  lastLoginIp     String?
  name            String?
  companyName     String?
  sector          String?
  // Canonical multi-sector list (slugs from src/lib/sectors.ts). Default behaviour
  // across the platform is to filter content by these. The legacy `sector` column
  // is kept for one release as a fallback bridge and will be dropped in a follow-up.
  sectors         String[]  @default([])
  language        String    @default("sq")
  role            Role      @default(USER)
  interests       String[]  @default([])
  onlyMySector    Boolean   @default(false)
  // Female-ownership self-declaration. Tri-state:
  //   true  = user declared the business has female ownership/co-ownership.
  //   false = user declared it explicitly does NOT.
  //   null  = user has not declared (default for legacy rows + skipped onboarding).
  // Filtering rule: female-targeted Grants/Fairs only surface to users with `true`.
  femaleOwnership Boolean?
  // Lloji i vetem i aktivitetit (slug nga src/lib/activity.ts). Boshti kryesor per grante.
  activityType    String?
  // Madhesia e kompanise sipas numrit te punetoreve. Vlerat: SMALL_1_9, MID_10_49, LARGE_50_249, XLARGE_250_PLUS.
  // E detyrueshme ne regjistrim te ri; opsionale historikisht per llogarite ekzistuese.
  employeeCount   String?
  // Sektoret e aktivizuar/faturuar nga admini; keta percaktojne dukshmerine.
  // Ndahen nga `sectors` (vetedeklarim). Default bosh => sheh vetem permbajtje te pergjithshme.
  entitledSectors String[]  @default([])
  emailVerified   DateTime?
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subscription         Subscription?
  notifications        Notification[]
  bookings             ConsultationBooking[]
  consultationRequests ConsultationRequest[]
  chatSessions         ChatSession[]
  accounts             Account[]
  sessions             Session[]

  // Faza 2 (Version 5): profil biznesi 1:1. Company.ownerUserId @unique => 1:1.
  company Company?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(INACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Grant {
  id                   String    @id @default(cuid())
  title                String
  titleSq              String?
  description          String    @db.Text
  descriptionSq        String?   @db.Text
  provider             String
  amount               String?
  currency             String    @default("EUR")
  deadline             DateTime?
  eligibility          String?   @db.Text
  url                  String?
  country              String?
  sectors              String[]  @default([])
  // Canonical sector slugs this opportunity targets. Empty array = universal
  // (shows to everyone). Non-empty = shows only to users whose sectors[] intersect.
  // A `cross-cutting` tag overrides this and always shows it as universal.
  targetSectors        String[]  @default([])
  tags                 String[]  @default([])
  // When true, this grant is restricted to businesses with female ownership.
  // Only users where `User.femaleOwnership=true` see it in the dashboard.
  forFemaleOwned       Boolean   @default(false)
  // Lloji i programit financiar: GRANT (grant klasik) ose SUBVENTION (subvencion paga/investime, p.sh. superpuna).
  kind                 String    @default("GRANT")
  // Audienca eksplicite. isGeneral=true => te te gjithe (perfshire tregtine).
  isGeneral            Boolean   @default(false)
  // Slug-et e aktivitetit qe targeton (bosh = pa kufizim aktiviteti).
  targetActivityTypes  String[]  @default([])
  // Dispeçimi nga admini: PENDING derisa admini te caktoje audiencen dhe te dergoje.
  dispatchStatus       String    @default("PENDING")
  dispatchedAt         DateTime?
  dispatchedById       String?
  isActive             Boolean   @default(true)
  scrapedAt            DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  isOngoing            Boolean   @default(false)
  classifiedAt         DateTime?
  classificationSource String?
  audience             String? // 'business' | 'civil_society' | 'mixed' | 'unknown'

  @@index([deadline])
  @@index([isActive])
}

model TradeFair {
  id                  String    @id @default(cuid())
  name                String
  nameSq              String?
  description         String?   @db.Text
  descriptionSq       String?   @db.Text
  location            String
  country             String
  startDate           DateTime
  endDate             DateTime
  website             String?
  sectors             String[]  @default([])
  // Canonical sector slugs this fair targets. See Grant.targetSectors for semantics.
  targetSectors       String[]  @default([])
  tags                String[]  @default([])
  // When true, this fair/event is restricted to businesses with female ownership.
  // Only users where `User.femaleOwnership=true` see it in the dashboard.
  forFemaleOwned      Boolean   @default(false)
  // Audienca eksplicite. isGeneral=true => te te gjithe (perfshire tregtine).
  isGeneral           Boolean   @default(false)
  // Slug-et e aktivitetit qe targeton (bosh = pa kufizim aktiviteti).
  targetActivityTypes String[]  @default([])
  // Dispeçimi nga admini: PENDING derisa admini te caktoje audiencen dhe te dergoje.
  dispatchStatus      String    @default("PENDING")
  dispatchedAt        DateTime?
  dispatchedById      String?
  eventType           EventType @default(FAIR)
  organizer           String?
  registrationUrl     String?
  isActive            Boolean   @default(true)
  scrapedAt           DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  @@index([startDate])
  @@index([isActive])
}

// Moduli Lajme / Informata (Faza D). Lajme biznesi qe lexohen brenda platformes
// dhe (opsionale) dergohen me email. Default = i pergjithshem (isGeneral=true):
// shkojne te te gjithe perfshire tregtine derisa admini te zgjedhe nje audience me te ngushte.
// Konventat e audiences + dispeçimit jane identike me Grant/TradeFair (slug strings, jo enum).
model NewsItem {
  id          String    @id @default(cuid())
  title       String
  titleSq     String?
  summary     String?   @db.Text
  body        String    @db.Text
  sourceName  String?
  sourceUrl   String?
  publishedAt DateTime?
  scrapedAt   DateTime  @default(now())

  // Audienca eksplicite. isGeneral=true => te te gjithe (perfshire tregtine).
  isGeneral           Boolean   @default(true)
  // Slug-et e aktivitetit/sektoreve qe targeton (bosh = pa kufizim ne ate bosht).
  targetActivityTypes String[]  @default([])
  targetSectors       String[]  @default([])
  forFemaleOwned      Boolean   @default(false)
  // Dispeçimi nga admini: PENDING derisa admini te caktoje audiencen dhe te dergoje.
  dispatchStatus      String    @default("PENDING")
  dispatchedAt        DateTime?
  dispatchedById      String?

  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive, publishedAt])
  @@index([dispatchStatus])
}

model ExportGuide {
  id            String   @id @default(cuid())
  title         String
  titleSq       String?
  titleEn       String?
  titleDe       String?
  content       String   @db.Text
  contentSq     String?  @db.Text
  contentEn     String?  @db.Text
  contentDe     String?  @db.Text
  country       String
  countryCode   String?  @unique // ISO 3166-1 alpha-2 (e.g. "DE", "US")
  flag          String? // emoji or short code
  sectors       String[] @default([])
  // Canonical sector slugs this guide targets. Empty = universal (most guides are
  // country-scoped, not sector-scoped, so default is empty).
  targetSectors String[] @default([])
  tags          String[] @default([])
  isPublished   Boolean  @default(true)

  // Structured guide content (Phase 12 - Claude-researched). All bilingual
  // string fields use { sq, en } shape inside the JSON.
  marketOverview  Json? // { sq, en } overview text
  customs         Json? // { vat, importDuties, authority: {name,url}, sourceUrl }
  requiredDocs    Json? // [{ name:{sq,en}, description:{sq,en}, mandatory, issuedBy?, sourceUrl }]
  certifications  Json? // [{ name, appliesTo[], description:{sq,en}, mandatory, authority, sourceUrl }]
  labeling        Json? // { languages[], rules: [{rule:{sq,en}, mandatory, sourceUrl}] }
  sectorRules     Json? // [{ sector, rules: [{rule:{sq,en}, mandatory, sourceUrl}] }]
  tradeAgreements Json? // [{ name, benefit:{sq,en}, sourceUrl }]
  contacts        Json? // [{ role, name?, address?, phone?, email?, url? }]
  citations       Json? // [{ title, url }]
  // Statistika tregu per-sektor (Eurostat etj.). { <sektor>: { sizeMEUR, sizeYear, sizeLabel, consumers, consumersYear, trend:[[year,val]], sources:[{label,url}] } }
  marketStats     Json?

  schemaVersion    Int       @default(1)
  generatedBy      String? // 'manual' | 'claude' | 'reviewed'
  lastResearchedAt DateTime?
  reviewedBy       String?
  reviewedAt       DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([country])
}

model Notification {
  // Arsyeja e transparencës (§14.6): 'Po e sheh sepse ke zgjedhur sektorin X'.
  reason    String?
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  titleSq   String?
  message   String           @db.Text
  messageSq String?          @db.Text
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model ConsultationBooking {
  id        String        @id @default(cuid())
  userId    String
  date      DateTime
  time      String
  topic     String
  notes     String?       @db.Text
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScraperLog {
  id         String   @id @default(cuid())
  type       String
  status     String
  message    String?  @db.Text
  itemsFound Int      @default(0)
  duration   Int?
  createdAt  DateTime @default(now())
}

// ============================================================
// Phase 11 — Multi-source scraping foundation
// ============================================================

enum SourceTier {
  A
  B
  C
  D
}

// Phase 1: controlled source lifecycle (governance metadata; does NOT drive
// ingestion, which still keys off Source.isActive). NULL = legacy/ungoverned.
enum SourceLifecycle {
  DRAFT
  PENDING_REVIEW
  APPROVED
  ACTIVE
  PAUSED
  DISABLED
  REJECTED
  ARCHIVED
}

enum SourceHealthState {
  UNKNOWN
  HEALTHY
  DEGRADED
  FAILING
  STALE
  PAUSED
  DISABLED
  AUTH_REQUIRED
  SCHEMA_CHANGED
}

enum SourceCategory {
  GRANT
  FAIR
  REGULATION
  MIXED
}

enum OpportunityType {
  GRANT
  FAIR
  REGULATION
}

enum OpportunityStatus {
  NEW
  REVIEWED
  PUBLISHED
  REJECTED
}

enum ScrapeStatus {
  SUCCESS
  PARTIAL
  FAILED
}

enum ScrapeTrigger {
  CRON
  N8N
  MANUAL
  API
}

model Source {
  // CONVENTION: Never DELETE a Source - use isActive=false instead.
  // CASCADE on child tables (Opportunity, ScrapeAttempt, SourceHealth) is for
  // emergency cleanup only. Admin UI must expose Deactivate, not Delete.
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  tier          SourceTier
  baseUrl       String
  category      SourceCategory
  language      String         @default("sq")
  strategies    Json
  isActive      Boolean        @default(true)
  schedule      String?
  // --- Source Registry / framework (additive) ---
  kind          String? // html | rss | wordpress | pdf | custom
  orgCategory   String? // government | municipality | donor | chamber | association
  reliability   String?        @default("medium") // high | medium | low
  publishMode   String         @default("review") // auto | review
  frequency     String         @default("daily") // daily | weekly
  sectorsHint   String[]       @default([])
  keywords      String[]       @default([])
  selectors     Json? // adapter config (feed url, list/item selectors, etc.)
  lastCheckedAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // --- Phase 1: Source governance (additive; all nullable/defaulted). Reuse
  // note: sectorsHint=relevantSectors, kind=accessMethod(legacy), category=primary
  // content type, reliability=operational score, SourceHealth.lastSuccessAt=last run.
  institutionName         String?
  description             String?
  officialDomain          String?
  sourceType              String? // ministry|agency|statistical|customs|regulator|bank|chamber|donor|media|directory
  country                 String?
  contentTypes            String[]          @default([])
  relevantRoles           String[]          @default([])
  relevantCountries       String[]          @default([])
  relevantHsChapters      String[]          @default([])
  accessMethod            String? // api|sdmx|jsonstat|rss|csv|excel|xml|sitemap|html|pdf|manual
  authenticationType      String?           @default("none") // none|apiKey|oauth|basic
  secretReference         String? // ENV VAR NAME ONLY — never a secret value
  license                 String?
  termsOfUseStatus        String?           @default("not_reviewed") // not_reviewed|approved|restricted|prohibited
  termsReviewedAt         DateTime?
  robotsStatus            String? // not_reviewed|allowed|restricted
  robotsReviewedAt        DateTime?
  attributionRequirements String?
  rateLimitPerMin         Int?
  concurrencyLimit        Int?
  requestTimeoutMs        Int?
  retryPolicy             Json?
  freshnessSlaHours       Int?
  nextScheduledRunAt      DateTime?
  healthStatus            SourceHealthState @default(UNKNOWN)
  owner                   String?
  reviewer                String?
  lifecycle               SourceLifecycle? // NULL = legacy/ungoverned; new sources start DRAFT
  autoPublishAllowed      Boolean           @default(false)
  notes                   String?

  opportunities Opportunity[]
  attempts      ScrapeAttempt[]
  health        SourceHealth?
  endpoints     SourceEndpoint[]

  @@index([tier, isActive])
  @@index([category])
  @@index([lifecycle])
}

// Phase 1: multiple governed endpoints per source (config only; live scraper
// logic is NOT migrated here per Phase 1 non-goals).
model SourceEndpoint {
  id               String            @id @default(cuid())
  sourceId         String
  name             String
  url              String
  endpointType     String? // api|sdmx|jsonstat|rss|csv|html|pdf
  contentType      String?
  accessMethod     String?
  authReference    String? // ENV VAR NAME ONLY
  datasetId        String?
  language         String?
  country          String?
  enabled          Boolean           @default(false)
  priority         Int               @default(0)
  rateLimitPerMin  Int?
  requestTimeoutMs Int?
  scheduleOverride String?
  lastCheckedAt    DateTime?
  lastSuccessAt    DateTime?
  healthStatus     SourceHealthState @default(UNKNOWN)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}

model Opportunity {
  id                  String            @id @default(cuid())
  sourceId            String
  externalId          String
  type                OpportunityType
  title               String
  titleEn             String?
  description         String?           @db.Text
  deadline            DateTime?
  amount              String?
  currency            String?           @default("EUR")
  eligibility         String?           @db.Text
  sourceUrl           String
  rawHtml             String?           @db.Text
  status              OpportunityStatus @default(NEW)
  firstSeenAt         DateTime          @default(now())
  lastSeenAt          DateTime          @default(now())
  attemptId           String?
  // --- Framework fields (additive) ---
  verificationStatus  String? // auto_publish | needs_review | published | rejected
  fingerprint         String?
  publishedAt         DateTime?
  amountMin           Int?
  amountMax           Int?
  supportTypes        String[]          @default([])
  documents           Json?
  attachments         Json?
  originalTextSnippet String?           @db.Text
  extractedFrom       String?
  scrapedAt           DateTime?

  source  Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  attempt ScrapeAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalId])
  @@index([type, status])
  @@index([deadline])
  @@index([lastSeenAt])
  @@index([fingerprint])
  @@index([verificationStatus])
}

model ScrapeAttempt {
  id           String        @id @default(cuid())
  sourceId     String
  strategyUsed Int
  startedAt    DateTime      @default(now())
  finishedAt   DateTime?
  status       ScrapeStatus
  itemsFound   Int           @default(0)
  itemsNew     Int           @default(0)
  itemsUpdated Int           @default(0)
  errorMessage String?       @db.Text
  durationMs   Int?
  triggeredBy  ScrapeTrigger

  source        Source        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@index([sourceId, startedAt])
  @@index([status])
}

model SourceHealth {
  sourceId            String    @id
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  consecutiveFailures Int       @default(0)
  currentStrategy     Int       @default(1)
  avgDurationMs       Int?
  totalItemsLifetime  Int       @default(0)
  updatedAt           DateTime  @updatedAt

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

enum ConsultationRequestType {
  GRANT_APPLICATION
  EXPORT_GUIDE
  FAIR_REGISTRATION
  CERTIFICATION
  CUSTOMS
  TRAINING
  INVESTOR_INQUIRY
  OTHER
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CONVERTED
  ARCHIVED
}

model ConsultationRequest {
  id         String                  @id @default(cuid())
  userId     String?
  name       String
  email      String
  phone      String?
  company    String?
  type       ConsultationRequestType
  contextId  String?
  contextRef String?
  message    String                  @db.Text
  status     LeadStatus              @default(NEW)
  source     String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  user       User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([type])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  sector         String?
  source         String?
  isActive       Boolean   @default(true)
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([isActive, createdAt])
}

enum ChatRole {
  USER
  ASSISTANT
  TOOL
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      ChatRole
  content   String      @db.Text
  toolName  String?
  toolData  Json?
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model HsQuery {
  id         String   @id @default(cuid())
  // Normalized query key (lowercase, trimmed) used for cache lookup.
  queryKey   String   @unique
  // The raw user input (preserved as typed).
  queryRaw   String
  // JSON returned by Haiku: { candidates: [...], notes: "...", documents: [...], disclaimer: "..." }
  result     Json
  // Optional: which user triggered the first lookup (for analytics; nullable).
  userId     String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  usageCount Int      @default(1)

  @@index([lastUsedAt])
}

// -----------------------------------------------------------------------------
// Faza 2 (Version 5): Company entity dhe extension-e sipas rolit.
// 1:1 me User përmes Company.ownerUserId @unique.
// -----------------------------------------------------------------------------

model Company {
  id          String @id @default(cuid())
  ownerUserId String @unique
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  // Roli i biznesit — pasqyron User.role (KOSOVO_BUSINESS/STARTUP/DIASPORA).
  // Individual/Admin/SuperAdmin nuk kanë Company.
  roleType Role

  // Identifikuesit përgjithësi. name = emri i biznesit ose emri i personit (Diaspora individ).
  name      String
  legalName String?

  // Fushat e migruara nga User (backward compat: mbeten edhe në User për 1 release).
  activityType    String?
  sectors         String[] @default([])
  employeeCount   String?
  femaleOwnership Boolean?

  // Vendndodhja / kontakti
  municipality  String?
  country       String? @default("Kosovë")
  address       String?
  email         String?
  phone         String?
  website       String?
  contactPerson String?

  // Prezantimi publik
  logoUrl          String?
  coverImageUrl    String?
  // Produktet/lendet qe biznesi kerkon te bleje (tekst i lire). Ushqen matcher-in
  // vendor (4a/4c) dhe ofertat e diaspores; bosh = pa sinjal blerjeje.
  productsSought   String[]  @default([])
  shortDescription String? @db.Text
  longDescription  String? @db.Text

  // Kontroll i shiküshmërisë + approval
  visibilityLevel VisibilityLevel @default(PRIVATE)
  profileStatus   ProfileStatus   @default(DRAFT)
  approvedAt      DateTime?
  approvedById    String?
  rejectedReason  String?

  // Ekstensione sipas rolit (1:1)
  startupProfile  StartupProfile?
  diasporaProfile DiasporaProfile?

  // Interesat / lookingFor si string arrays (§1.3, §2). Vlerat: buyer, investor,
  // distributor, importer, partner, service_provider, export/import, industrial_parks etj.
  interests String[] @default([])

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  offerings       Offering[]
  offerResponses  OfferResponse[]
  contactRequests ContactRequest[]

  @@index([roleType, profileStatus])
  @@index([visibilityLevel])
  @@index([country])
}

model StartupProfile {
  companyId String  @id
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  stage             StartupStage @default(IDEA)
  intendedLegalForm LegalForm?

  // Nevojat si string arrays: ARBK, NACE, statut, banke, atk_edi, kontabilist,
  // grant, mentorim, business_plan, investitor, buyer, distributor.
  needs String[] @default([])

  hasProduct   Boolean @default(false)
  prototypeUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DiasporaProfile {
  companyId String  @id
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Vendi kryesor ku vepron biznesi i diasporës (p.sh. "DE" ose "Gjermani").
  countryOfOperation String
  city               String?
  // Shtete të tjera ku ka aktivitet tregtar.
  countriesActive    String[] @default([])

  // Nën-rolet e shumefishta (§1.3): buyer/investor/distributor/importer/partner/service_provider.
  subRoles DiasporaSubRole[] @default([])

  // Sektorët e interesit + produktet që kërkon ose ofron (string arrays për fleksibilitet).
  sectorsOfInterest String[] @default([])
  productsSought    String[] @default([])
  productsOffered   String[] @default([])

  // Deklarata + kapitali orientues (opsional).
  purposeSummary   String? @db.Text
  investmentBudget String?
  marketShare      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Audit Trail (§12 V5): çdo veprim kritik i adminit — kush, çka, kur.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String
  action     String
  entityType String
  entityId   String?
  summary    String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorEmail])
}

// -----------------------------------------------------------------------------
// Faza A (V5 §3): Taksonomia — Sektor → Kategori produkti/shërbimi → Ofertë.
// Kategoritë janë të strukturuara (jo tekst i lirë); bizneset propozojnë
// kategori të reja që presin aprovimin e adminit.
// -----------------------------------------------------------------------------

model ProductCategory {
  id         String   @id @default(cuid())
  sectorSlug String
  nameSq     String
  slug       String   @unique
  status     String   @default("APPROVED") // APPROVED | PENDING (propozim biznesi)
  proposedBy String? // companyId që e propozoi (për PENDING)
  createdAt  DateTime @default(now())

  offerings    Offering[]
  OfferRequest OfferRequest[]

  @@index([sectorSlug, status])
}

model Offering {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title       String
  description String?          @db.Text
  status      String           @default("APPROVED") // PENDING kur kategoria është propozim i ri
  createdAt   DateTime         @default(now())

  @@index([companyId])
  @@index([categoryId, status])
}

// -----------------------------------------------------------------------------
// Faza B (V5 §5): Kërko Ofertë — kërkesa, ofertat përgjigje, kontakti i kontrolluar.
// -----------------------------------------------------------------------------

model OfferRequest {
  id                 String           @id @default(cuid())
  requesterUserId    String
  requesterCompanyId String?
  title              String
  description        String           @db.Text
  categoryId         String?
  category           ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sectorSlug         String?
  quantity           String?
  destinationCountry String?
  deadline           DateTime?
  specifications     String?          @db.Text
  budget             String?
  verifiedOnly       Boolean          @default(false)
  status             String           @default("OPEN") // OPEN | CLOSED | AWARDED | WITHDRAWN
  notifiedCount      Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  responses OfferResponse[]

  @@index([status, createdAt])
  @@index([categoryId])
  @@index([requesterUserId])
}

model OfferResponse {
  id        String       @id @default(cuid())
  requestId String
  request   OfferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  companyId String
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  message   String       @db.Text
  priceInfo String?
  status    String       @default("SENT") // SENT | SHORTLISTED | REJECTED | ACCEPTED
  createdAt DateTime     @default(now())

  @@unique([requestId, companyId])
  @@index([companyId])
}

model ContactRequest {
  id          String    @id @default(cuid())
  fromUserId  String
  toCompanyId String
  toCompany   Company   @relation(fields: [toCompanyId], references: [id], onDelete: Cascade)
  message     String    @db.Text
  status      String    @default("PENDING") // PENDING | APPROVED | DECLINED
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([fromUserId, toCompanyId])
}

// Template-t e dokumenteve per Udhezuesin ARBK (statut, akt themelimi, etj.).
// Skedaret ruhen ne DB (bytea) qe te mbijetojne rindertimet e .next dhe te hyjne ne dump.
model ArbkTemplate {
  key          String   @id
  title        String
  fileName     String
  mimeType     String
  data         Bytes
  size         Int
  uploadedAt   DateTime @default(now())
  uploadedById String?
}

// Imazhet e ngarkuara (logo kompanish, foto produktesh). Blob-et rrine ketu,
// jashte tabelave Company/Offering, qe query-t te mos i terheqin kurre bytes-at.
model MediaAsset {
  id        String   @id @default(cuid())
  kind      String   // 'COMPANY_LOGO' | 'OFFERING_IMAGE'
  refId     String
  mime      String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())

  @@unique([kind, refId])
  @@index([refId])
}


// Njoftimet e Tregut te Energjise (KOSTT/KESCO/KEK/ZRRE). Shfaqen te modulit
// per bizneset 50+ punetore; ofertat mund te targetohen te prodhuesit.
model EnergyNotice {
  id           String    @id @default(cuid())
  source       String
  kind         String    @default("NEWS")
  title        String
  body         String    @db.Text
  url          String?
  forProducers Boolean   @default(false)
  publishedAt  DateTime  @default(now())
  dispatchedAt DateTime?
  createdById  String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}


// Çmimet e tregut te energjise (ALPEX/HUPX + oferta furnizuesish). I fut admini,
// i verifikuar; shfaqen te moduli me trend + lidhje live te bursa.
model EnergyPrice {
  id           String    @id @default(cuid())
  market       String
  supplier     String?
  price        Float
  unit         String    @default("EUR/MWh")
  refDate      DateTime
  note         String?
  url          String?
  dispatchedAt DateTime?
  createdById  String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
}
