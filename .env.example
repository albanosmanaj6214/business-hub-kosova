# Kosova Business Hub — variablat e mjedisit
# Kopjoje si `.env` dhe plotësoji. `.env` NUK futet kurrë në git (shih .gitignore).
# Aplikacioni niset me katër të parat; pjesa tjetër aktivizon funksione shtesë.

# ── E DETYRUESHME ────────────────────────────────────────────────────────────
# Lidhja me PostgreSQL 16.
DATABASE_URL="postgresql://user:password@localhost:5432/businesshub_db"
# URL-ja bazë e aplikacionit. Përcakton edhe emrin e cookie-t të seancës:
# me https => `__Secure-next-auth.session-token`, me http => pa prefiks.
NEXTAUTH_URL="http://localhost:3000"
# Sekreti i nënshkrimit të JWT-ve. Gjenero me: openssl rand -base64 32
NEXTAUTH_SECRET=""
# URL-ja publike, e inline-uar në build (metadata, sitemap, robots, OpenGraph).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── NDËRFAQJA ────────────────────────────────────────────────────────────────
# Aktivizon menynë anësore sipas rolit. NEXT_PUBLIC_* inline-ohet gjatë `build`,
# pra ndryshimi kërkon rindërtim, jo vetëm rinisje.
NEXT_PUBLIC_ROLE_BASED_SIDEBAR="true"

# ── SIGURIA: Cloudflare Turnstile (CAPTCHA në hyrje dhe regjistrim) ──────────
# KUJDES: çelësat e testimit të Cloudflare kalojnë GJITHMONË — pa mbrojtje reale.
# Në prodhim duhen çelësa realë nga dash.cloudflare.com → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── EMAIL (Resend) ───────────────────────────────────────────────────────────
# Pa këtë, verifikimi i emailit NUK dërgohet; `sendVerificationEmail` kthen
# ok:false dhe e shtyp URL-në në log që zhvillimi lokal të vazhdojë.
RESEND_API_KEY=""
EMAIL_FROM="Kosova Business Hub <noreply@shembull.com>"

# ── AI (opsionale; pa to funksionet përkatëse bien në sjellje boshe) ─────────
# Anthropic — VETËM Haiku përdoret: ekstraktim PDF/DOCX, udhëzues vendi,
# klasifikim afatesh, HS-code finder. Politika e projektit: asnjë model tjetër.
ANTHROPIC_API_KEY=""
# Google Gemini — asistenti chat "Konsulenti".
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ── SCRAPER ──────────────────────────────────────────────────────────────────
# Mbron `POST /api/scraper` (header `x-scraper-secret`).
SCRAPER_SECRET=""
# Aktivizon pasurimin me AI gjatë scraping-ut. I FIKUR si parazgjedhje:
# ndez shpenzim të paguar në çdo run të natës. Ndize vetëm me leje shprehimore.
SCRAPER_AI_ENRICH="false"
# Pasurim per-burim me Haiku + kufiri i thirrjeve për run. Të njëjtat kushte.
KIESA_ENRICH="false"
KIESA_ENRICH_MAX="5"
MINT_ENRICH="false"
MINT_ENRICH_MAX="5"
MZHR_ENRICH="false"
MZHR_ENRICH_MAX="5"
# Vetëm për daemon-in e veçantë `scraper.js` (shih DEPLOY.md — sot përdoret
# systemd timer-i `kbh-scraper.timer`, jo ky daemon).
SCRAPER_URL="http://localhost:3000/api/scraper"
SCRAPER_CRON="0 3 * * *"
SCRAPER_TZ="Europe/Belgrade"
SCRAPER_RUN_ON_START="0"

# ── PAGESAT (Stripe) ─────────────────────────────────────────────────────────
# Kodi ekziston por nuk përdoret: nivelet caktohen manualisht. Stripe nuk
# mbështet Kosovën, prandaj sistemi i faturimit është i parkuar.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── OPERACIONALE ─────────────────────────────────────────────────────────────
# Mbron `POST /api/admin/trash/cron-purge`.
CRON_SECRET=""
# Njoftime operacionale (alarme shëndeti, lead-e). Pa to, vetëm në log.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
NOTIFY_EMAIL=""

# ── VETËM ZHVILLIM / QA ──────────────────────────────────────────────────────
# Hap `GET /api/dev/impersonate?key=...&role=...` që lëshon cookie seance për
# llogari testuese (@kbh.test / @test.local), pa fjalëkalim. Rolet admin
# refuzohen. DUHET të jetë `false` në prodhim.
DEV_IMPERSONATION_ENABLED="false"
DEV_IMPERSONATION_KEY=""
