generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INACTIVE
}

enum SubscriptionTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum NotificationType {
  GRANT
  FAIR
  GUIDE
  SYSTEM
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELED
  COMPLETED
}

enum EventType {
  FAIR
  TRAINING
  WEBINAR
  MATCHMAKING
  WORKSHOP
  CONFERENCE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  companyName   String?
  sector        String?
  language      String    @default("sq")
  role          Role      @default(USER)
  interests     String[]  @default([])
  onlyMySector  Boolean   @default(false)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subscription  Subscription?
  notifications Notification[]
  bookings      ConsultationBooking[]
  consultationRequests ConsultationRequest[]
  chatSessions  ChatSession[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(INACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Grant {
  id            String    @id @default(cuid())
  title         String
  titleSq       String?
  description   String    @db.Text
  descriptionSq String?   @db.Text
  provider      String
  amount        String?
  currency      String    @default("EUR")
  deadline      DateTime?
  eligibility   String?   @db.Text
  url           String?
  country       String?
  sectors       String[]  @default([])
  tags          String[]  @default([])
  isActive      Boolean   @default(true)
  scrapedAt     DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt DateTime?
  isOngoing            Boolean   @default(false)
  classifiedAt         DateTime?
  classificationSource String?
  audience             String?  // 'business' | 'civil_society' | 'mixed' | 'unknown'

  @@index([deadline])
  @@index([isActive])
}

model TradeFair {
  id            String   @id @default(cuid())
  name          String
  nameSq        String?
  description   String?  @db.Text
  descriptionSq String?  @db.Text
  location      String
  country       String
  startDate     DateTime
  endDate       DateTime
  website       String?
  sectors       String[] @default([])
  tags          String[] @default([])
  eventType     EventType @default(FAIR)
  organizer     String?
  registrationUrl String?
  isActive      Boolean  @default(true)
  scrapedAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt DateTime?

  @@index([startDate])
  @@index([isActive])
}

model ExportGuide {
  id          String   @id @default(cuid())
  title       String
  titleSq     String?
  titleEn     String?
  titleDe     String?
  content     String   @db.Text
  contentSq   String?  @db.Text
  contentEn   String?  @db.Text
  contentDe   String?  @db.Text
  country     String
  countryCode String?  @unique // ISO 3166-1 alpha-2 (e.g. "DE", "US")
  flag        String? // emoji or short code
  sectors     String[] @default([])
  tags        String[] @default([])
  isPublished Boolean  @default(true)

  // Structured guide content (Phase 12 - Claude-researched). All bilingual
  // string fields use { sq, en } shape inside the JSON.
  marketOverview  Json? // { sq, en } overview text
  customs         Json? // { vat, importDuties, authority: {name,url}, sourceUrl }
  requiredDocs    Json? // [{ name:{sq,en}, description:{sq,en}, mandatory, issuedBy?, sourceUrl }]
  certifications  Json? // [{ name, appliesTo[], description:{sq,en}, mandatory, authority, sourceUrl }]
  labeling        Json? // { languages[], rules: [{rule:{sq,en}, mandatory, sourceUrl}] }
  sectorRules     Json? // [{ sector, rules: [{rule:{sq,en}, mandatory, sourceUrl}] }]
  tradeAgreements Json? // [{ name, benefit:{sq,en}, sourceUrl }]
  contacts        Json? // [{ role, name?, address?, phone?, email?, url? }]
  citations       Json? // [{ title, url }]

  schemaVersion    Int       @default(1)
  generatedBy      String? // 'manual' | 'claude' | 'reviewed'
  lastResearchedAt DateTime?
  reviewedBy       String?
  reviewedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([country])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  titleSq   String?
  message   String           @db.Text
  messageSq String?          @db.Text
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model ConsultationBooking {
  id        String        @id @default(cuid())
  userId    String
  date      DateTime
  time      String
  topic     String
  notes     String?       @db.Text
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScraperLog {
  id         String   @id @default(cuid())
  type       String
  status     String
  message    String?  @db.Text
  itemsFound Int      @default(0)
  duration   Int?
  createdAt  DateTime @default(now())
}

// ============================================================
// Phase 11 — Multi-source scraping foundation
// ============================================================

enum SourceTier {
  A
  B
  C
}

enum SourceCategory {
  GRANT
  FAIR
  REGULATION
  MIXED
}

enum OpportunityType {
  GRANT
  FAIR
  REGULATION
}

enum OpportunityStatus {
  NEW
  REVIEWED
  PUBLISHED
  REJECTED
}

enum ScrapeStatus {
  SUCCESS
  PARTIAL
  FAILED
}

enum ScrapeTrigger {
  CRON
  N8N
  MANUAL
  API
}

model Source {
  // CONVENTION: Never DELETE a Source - use isActive=false instead.
  // CASCADE on child tables (Opportunity, ScrapeAttempt, SourceHealth) is for
  // emergency cleanup only. Admin UI must expose Deactivate, not Delete.
  id         String         @id @default(cuid())
  code       String         @unique
  name       String
  tier       SourceTier
  baseUrl    String
  category   SourceCategory
  language   String         @default("sq")
  strategies Json
  isActive   Boolean        @default(true)
  schedule   String?
  // --- Source Registry / framework (additive) ---
  kind          String?   // html | rss | wordpress | pdf | custom
  orgCategory   String?   // government | municipality | donor | chamber | association
  reliability   String?   @default("medium") // high | medium | low
  publishMode   String    @default("review") // auto | review
  frequency     String    @default("daily")  // daily | weekly
  sectorsHint   String[]  @default([])
  keywords      String[]  @default([])
  selectors     Json?     // adapter config (feed url, list/item selectors, etc.)
  lastCheckedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  opportunities Opportunity[]
  attempts      ScrapeAttempt[]
  health        SourceHealth?

  @@index([tier, isActive])
  @@index([category])
}

model Opportunity {
  id          String            @id @default(cuid())
  sourceId    String
  externalId  String
  type        OpportunityType
  title       String
  titleEn     String?
  description String?           @db.Text
  deadline    DateTime?
  amount      String?
  currency    String?           @default("EUR")
  eligibility String?           @db.Text
  sourceUrl   String
  rawHtml     String?           @db.Text
  status      OpportunityStatus @default(NEW)
  firstSeenAt DateTime          @default(now())
  lastSeenAt  DateTime          @default(now())
  attemptId   String?
  // --- Framework fields (additive) ---
  verificationStatus  String?   // auto_publish | needs_review | published | rejected
  fingerprint         String?
  publishedAt         DateTime?
  amountMin           Int?
  amountMax           Int?
  supportTypes        String[]  @default([])
  documents           Json?
  attachments         Json?
  originalTextSnippet String?   @db.Text
  extractedFrom       String?
  scrapedAt           DateTime?

  source  Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  attempt ScrapeAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalId])
  @@index([type, status])
  @@index([deadline])
  @@index([lastSeenAt])
  @@index([fingerprint])
  @@index([verificationStatus])
}

model ScrapeAttempt {
  id           String        @id @default(cuid())
  sourceId     String
  strategyUsed Int
  startedAt    DateTime      @default(now())
  finishedAt   DateTime?
  status       ScrapeStatus
  itemsFound   Int           @default(0)
  itemsNew     Int           @default(0)
  itemsUpdated Int           @default(0)
  errorMessage String?       @db.Text
  durationMs   Int?
  triggeredBy  ScrapeTrigger

  source        Source        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@index([sourceId, startedAt])
  @@index([status])
}

model SourceHealth {
  sourceId            String    @id
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  consecutiveFailures Int       @default(0)
  currentStrategy     Int       @default(1)
  avgDurationMs       Int?
  totalItemsLifetime  Int       @default(0)
  updatedAt           DateTime  @updatedAt

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
}

enum ConsultationRequestType {
  GRANT_APPLICATION
  EXPORT_GUIDE
  FAIR_REGISTRATION
  CERTIFICATION
  CUSTOMS
  TRAINING
  INVESTOR_INQUIRY
  OTHER
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CONVERTED
  ARCHIVED
}

model ConsultationRequest {
  id         String                  @id @default(cuid())
  userId     String?
  name       String
  email      String
  phone      String?
  company    String?
  type       ConsultationRequestType
  contextId  String?
  contextRef String?
  message    String                  @db.Text
  status     LeadStatus              @default(NEW)
  source     String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  user       User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([type])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  sector         String?
  source         String?
  isActive       Boolean   @default(true)
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([isActive, createdAt])
}

enum ChatRole {
  USER
  ASSISTANT
  TOOL
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      ChatRole
  content   String      @db.Text
  toolName  String?
  toolData  Json?
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model HsQuery {
  id          String   @id @default(cuid())
  // Normalized query key (lowercase, trimmed) used for cache lookup.
  queryKey    String   @unique
  // The raw user input (preserved as typed).
  queryRaw    String
  // JSON returned by Haiku: { candidates: [...], notes: "...", documents: [...], disclaimer: "..." }
  result      Json
  // Optional: which user triggered the first lookup (for analytics; nullable).
  userId      String?
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())
  usageCount  Int      @default(1)

  @@index([lastUsedAt])
}
